# Copie para .env.local e preencha localmente. NUNCA versione valores reais.
# Em homologação e produção, configure os valores na Vercel (por ambiente).

# Ambiente: development | staging | production
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — cada ambiente usa um projeto separado (a partir do M1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor. Jamais prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cofre: chave mestra da criptografia dos arquivos (32 bytes em base64). Somente servidor.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde também no gerenciador de senhas da Jéssica e numa cópia offline: sem ela, os arquivos não abrem.
VAULT_MASTER_KEY=
VAULT_MASTER_KEY_VERSION=1
# Chaves antigas após rotação, só para abrir arquivos antigos: "1:base64,2:base64"
VAULT_PREVIOUS_KEYS=
